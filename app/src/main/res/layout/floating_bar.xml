<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <Button
        android:id="@+id/button1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/power"
        android:visibility="visible" />

    <Button
        android:id="@+id/button2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/volume"
        android:visibility="visible" />

    <Button
        android:id="@+id/scrollUp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/scrollUp"
        android:visibility="visible" />

    <Button
        android:id="@+id/scrollDown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/scrollDown"
        android:visibility="visible" />

    <Button
        android:id="@+id/swipeLeft"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/swipeLeft"
        android:visibility="visible" />

    <Button
        android:id="@+id/swipeRight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/swipeRight"
        android:visibility="visible" />

    <Button
        android:id="@+id/simulateTouch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/simulateTouch"
        android:visibility="visible" />

    <Button
        android:id="@+id/btnHome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Home" />

    <Button
        android:id="@+id/doubleTap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2 Tap" />

</LinearLayout>